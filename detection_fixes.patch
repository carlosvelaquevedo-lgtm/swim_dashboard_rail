+    def _detect_tracked(self, frame, timestamp_ms):
+        """Detect pose using a smoothed tracking crop ("virtual camera").
+
+        MediaPipe's person detector internally resizes its input to ~256px —
+        a distant swimmer simply vanishes at that scale, no matter how high
+        the source resolution is. Cropping a padded window around the last
+        known swimmer position before detection makes the swimmer fill the
+        model's input, dramatically improving detection on far-away footage.
+        Landmarks are remapped to full-frame normalized coordinates in place,
+        so ALL downstream code (gates, metrics, drawing) is unchanged.
+        Returns (result, used_crop_box_or_None).
+        """
+        H, W = frame.shape[:2]
+        crop_box = None
+        if self._track_center is not None and self._track_size is not None:
+            cx, cy = self._track_center
+            half = self._track_size
+            x0 = int(max(0, cx - half)); x1 = int(min(W, cx + half))
+            y0 = int(max(0, cy - half * 0.75)); y1 = int(min(H, cy + half * 0.75))
+            # Only crop when it's meaningfully smaller than the frame and big
+            # enough for the landmarker to work with.
+            if (x1 - x0) >= 200 and (y1 - y0) >= 150 and (x1 - x0) < int(W * 0.95):
+                crop_box = (x0, y0, x1, y1)
+
+        def _detect(img_bgr, ts):
+            rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)
+            mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)
+            return self.landmarker.detect_for_video(mp_image, ts)
+
+        used_crop = None
+        if crop_box is not None:
+            x0, y0, x1, y1 = crop_box
+            result = _detect(frame[y0:y1, x0:x1], timestamp_ms)
+            if result.pose_landmarks:
+                used_crop = crop_box
+            else:
+                # Lost inside the crop → re-detect on the full frame
+                # (detect_for_video requires a strictly increasing timestamp)
+                self.last_timestamp_ms += 1
+                result = _detect(frame, self.last_timestamp_ms)
+        else:
+            result = _detect(frame, timestamp_ms)
+
+        if not result.pose_landmarks:
+            # Lose the track so the next frame starts from a clean full-frame pass
+            self._track_center = None
+            self._track_size = None
+            return result, None
+
+        # Remap crop-space landmarks to full-frame normalized coords IN PLACE
+        if used_crop is not None:
+            x0, y0, x1, y1 = used_crop
+            cw, ch = float(x1 - x0), float(y1 - y0)
+            for lm in result.pose_landmarks[0]:
+                lm.x = (lm.x * cw + x0) / W
+                lm.y = (lm.y * ch + y0) / H
+
+        # Update the smoothed track from the detected bounding box
+        xs = [lm.x * W for lm in result.pose_landmarks[0]]
+        ys = [lm.y * H for lm in result.pose_landmarks[0]]
+        bcx = (min(xs) + max(xs)) / 2.0
+        bcy = (min(ys) + max(ys)) / 2.0
+        span = max(max(xs) - min(xs), max(ys) - min(ys))
+        target_half = max(span * 1.6, 260.0)  # generous padding, never razor-tight
+        alpha = 0.25  # EMA smoothing — keeps the crop stable frame-to-frame
+        if self._track_center is None:
+            self._track_center = (bcx, bcy)
+            self._track_size = target_half
+        else:
+            pcx, pcy = self._track_center
+            self._track_center = (pcx * (1 - alpha) + bcx * alpha,
+                                  pcy * (1 - alpha) + bcy * alpha)
+            self._track_size = self._track_size * (1 - alpha) + target_half * alpha
+
+        return result, used_crop
